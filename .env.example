# 首次启动自动生成 .env。Windows 默认位于 %LOCALAPPDATA%\Liuyao\.env。
# 填入自己厂商账户的密钥，保存后重启软件。
# .env 和案例数据只保留在自己的电脑，不要分享。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# 多模型可选：填写自己账户可用的模型名称，以英文逗号分隔。
DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-flash
# 默认质量 max，开启深度思考。可按需改成 high 或 low；none 关闭思考。
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_THINKING=enabled
# 同时包含思考与最终回答，沿用官方 max 档默认额度；不是要求输出这么长。
DEEPSEEK_MAX_TOKENS=131072

# 豆包使用火山方舟。填写已开通的模型名或推理接入点 ID。
DOUBAO_API_KEY=
DOUBAO_MODEL=
DOUBAO_MODELS=

# 单次模型请求超时秒数（1—1800）。max 思考可能更久，后台会显示当前阶段。
AI_TIMEOUT_SECONDS=600
